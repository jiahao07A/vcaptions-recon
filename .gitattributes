# Files under src/bundles/ are byte-exact Parcel output. Any end-of-line or
# encoding normalisation would change their bytes and break `npm run verify`,
# which compares against the digests recorded in src/bundles/index.json.
src/bundles/** -text -diff

# The recorded manifests and any downloaded archive are binary as well.
*.crx binary
*.zip binary

# The baseline is intentionally absent from this repository; it is restored via
# `npm run fetch-baseline`. Listing it here keeps git from ever staging it if a
# local copy exists.
assets/baseline/** -text -diff
